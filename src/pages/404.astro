---
import Base from '../layouts/Base.astro';
import Window from '../components/Window.astro';
---
<Base title="Not found" noindex>
  <Window name="404.txt" front status="Error 404">
    <h1 class="section-title">File not found</h1>
    <p>Nothing lives at this address. Try the <a href="/">start page</a>, the <a href="/devlog/">devlog</a> or <a href="/play/">play</a>.</p>
  </Window>
</Base>
